---
import Layout from '../../layouts/Layout.astro';

const error = Astro.url.searchParams.get('error');
---
<Layout title="Ingresar · Admin">
  <div class="shell" style="max-width:400px;padding-top:80px">
    <h1>Panel admin</h1>
    <p style="color:var(--ink-muted);margin-top:-8px">Calendario de colaboradores</p>

    {error && <div class="alert error">{error}</div>}

    <form method="POST" action="/api/auth/login" class="card" style="margin-top:20px">
      <div class="field">
        <label for="email">Correo</label>
        <input type="email" id="email" name="email" required autofocus />
      </div>
      <div class="field">
        <label for="password">Contraseña</label>
        <input type="password" id="password" name="password" required />
      </div>
      <button type="submit" class="btn" style="width:100%;justify-content:center">Entrar</button>
    </form>

    <p style="color:var(--ink-muted);font-size:0.85rem;margin-top:16px">
      Los usuarios se crean y administran desde <strong>Usuarios</strong> dentro
      del panel (solo super_admin). Si aún no tienes ninguno, créalo desde
      Supabase (Authentication → Users → Add user).
    </p>
  </div>
</Layout>
