---
import Layout from '../../layouts/Layout.astro';

const error = Astro.url.searchParams.get('error');
const sent = Astro.url.searchParams.get('sent');
---
<Layout title="Recuperar contraseña · Admin">
  <div class="shell" style="max-width:400px;padding-top:80px">
    <h1>Recuperar contraseña</h1>
    <p style="color:var(--on-bg-muted);margin-top:-8px">
      Te enviaremos un enlace para restablecerla.
    </p>

    {error && <div class="alert error">{error}</div>}
    {sent && (
      <div class="alert ok">
        Si el correo está registrado, te enviamos un enlace para restablecer tu
        contraseña. Es válido por 15 minutos.
      </div>
    )}

    <form method="POST" action="/api/auth/forgot-password" class="card" style="margin-top:20px">
      <div class="field">
        <label for="email">Correo</label>
        <input type="email" id="email" name="email" required autofocus />
      </div>
      <button type="submit" class="btn" style="width:100%;justify-content:center">Enviar enlace</button>
    </form>

    <p style="font-size:0.85rem;margin-top:16px">
      <a href="/admin/login" style="color:var(--on-bg)">Volver a iniciar sesión</a>
    </p>
  </div>
</Layout>
