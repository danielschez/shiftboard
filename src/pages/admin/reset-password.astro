---
import Layout from '../../layouts/Layout.astro';

const tokenHash = Astro.url.searchParams.get('token_hash');
const error = Astro.url.searchParams.get('error');
---
<Layout title="Nueva contraseña · Admin">
  <div class="shell" style="max-width:400px;padding-top:80px">
    <h1>Nueva contraseña</h1>
    <p style="color:var(--on-bg-muted);margin-top:-8px">
      Elige una contraseña de al menos 8 caracteres.
    </p>

    {error && <div class="alert error">{error}</div>}

    {!tokenHash ? (
      <div class="alert error">
        El enlace no es válido. <a href="/admin/forgot-password">Solicita uno nuevo</a>.
      </div>
    ) : (
      <form method="POST" action="/api/auth/reset-password" class="card" style="margin-top:20px">
        <input type="hidden" name="token_hash" value={tokenHash} />
        <div class="field">
          <label for="password">Nueva contraseña</label>
          <input type="password" id="password" name="password" minlength="8" required autofocus autocomplete="new-password" />
        </div>
        <div class="field">
          <label for="confirm">Confirmar contraseña</label>
          <input type="password" id="confirm" name="confirm" minlength="8" required autocomplete="new-password" />
        </div>
        <button type="submit" class="btn" style="width:100%;justify-content:center">Guardar contraseña</button>
      </form>
    )}
  </div>
</Layout>
