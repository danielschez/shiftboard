---
import AdminLayout from '../../layouts/AdminLayout.astro';

const error = Astro.url.searchParams.get('error');
const ok = Astro.url.searchParams.get('ok');

const { data: shifts } = await Astro.locals.supabase
  .from('shifts')
  .select('id, name, start_time, end_time, rotates')
  .order('start_time');

const { data: collaborators } = await Astro.locals.supabase
  .from('collaborators')
  .select('id, full_name, active, shift_id, shifts(name, start_time, end_time, rotates)')
  .order('full_name');

const { data: effectiveToday } = await Astro.locals.supabase
  .from('collaborator_effective_shift_today')
  .select('collaborator_id, effective_shift_id');

const shiftsById = new Map((shifts ?? []).map((s) => [s.id, s]));
const effectiveByCollaborator = new Map(
  (effectiveToday ?? []).map((e: any) => [e.collaborator_id, e.effective_shift_id])
);
---
<AdminLayout title="Colaboradores" active="colaboradores">
  <h1>Colaboradores</h1>

  {error && <div class="alert error">{decodeURIComponent(error)}</div>}
  {ok && <div class="alert ok">Guardado correctamente.</div>}

  <div class="card" style="margin-bottom:24px">
    <h2 style="margin-bottom:14px">Dar de alta</h2>
    <form method="POST" action="/api/admin/collaborators">
      <div class="field">
        <label for="full_name">Nombre completo</label>
        <input type="text" id="full_name" name="full_name" required />
      </div>
      <div class="field">
        <label for="shift_id">Turno base</label>
        <select id="shift_id" name="shift_id" required>
          {(shifts ?? []).map((s) => (
            <option value={s.id}>{s.name} ({s.start_time}–{s.end_time}){s.rotates ? ' · rota cada 4 semanas' : ''}</option>
          ))}
        </select>
      </div>
      <button type="submit" class="btn">Agregar colaborador</button>
    </form>
  </div>

  <h2>Todos</h2>
  <p style="color:var(--on-bg-muted);margin-top:-8px;font-size:0.85rem">
    "Turno base" es el que tiene guardado; "turno hoy" es el que le toca en la
    rotación actual — si no coinciden, es porque ya rotó desde que se dio de alta.
  </p>
  <div style="display:flex;flex-direction:column;gap:10px">
    {(collaborators ?? []).map((c: any) => {
      const effectiveId = effectiveByCollaborator.get(c.id);
      const effectiveShift = effectiveId ? shiftsById.get(effectiveId) : null;
      const rotated = c.shifts?.rotates && effectiveId && effectiveId !== c.shift_id;
      return (
        <div class="card user-row">
          <form method="POST" action={`/api/admin/collaborators/${c.id}/edit`} class="user-edit-grid">
            <div class="field" style="margin-bottom:0">
              <label for={`name-${c.id}`}>Nombre</label>
              <input id={`name-${c.id}`} type="text" name="full_name" value={c.full_name} />
            </div>
            <div class="field" style="margin-bottom:0">
              <label for={`shift-${c.id}`}>Turno base</label>
              <select id={`shift-${c.id}`} name="shift_id">
                {(shifts ?? []).map((s) => (
                  <option value={s.id} selected={s.id === c.shift_id}>{s.name}</option>
                ))}
              </select>
            </div>
            <div class="field" style="margin-bottom:0">
              <label>Turno hoy</label>
              <div class="static-value">
                {effectiveShift?.name ?? '—'}
                {rotated && <span class="tag" style="margin-left:6px">rotó</span>}
              </div>
            </div>
            <div class="field" style="margin-bottom:0">
              <label>Estado</label>
              <div class="static-value">{c.active ? 'Activo' : 'Inactivo'}</div>
            </div>
            <div style="align-self:end">
              <button type="submit" class="btn secondary" style="width:100%">Guardar</button>
            </div>
          </form>
          <div style="display:flex;flex-direction:column;gap:6px;margin-left:12px">
            <form method="POST" action={`/api/admin/collaborators/${c.id}/toggle`}>
              <button type="submit" class="btn secondary" style="padding:5px 10px;font-size:0.82rem;width:100%">
                {c.active ? 'Desactivar' : 'Activar'}
              </button>
            </form>
            <form method="POST" action={`/api/admin/collaborators/${c.id}/delete`}>
              <button type="submit" class="btn danger" style="padding:5px 10px;font-size:0.82rem;width:100%">Eliminar</button>
            </form>
          </div>
        </div>
      );
    })}
  </div>
</AdminLayout>
