---
import Layout from '../layouts/Layout.astro';
import { buildMonthGrid, monthLabel, dayOfWeekLabels, toISODate, addMonths } from '../lib/calendar';

const today = new Date();
const year = Number(Astro.url.searchParams.get('y')) || today.getFullYear();
const month = Number(Astro.url.searchParams.get('m')) || today.getMonth() + 1;

const grid = buildMonthGrid(year, month);
const rangeStart = toISODate(grid[0]);
const rangeEnd = toISODate(grid[grid.length - 1]);

const { data: eventTypes } = await Astro.locals.supabase
  .from('event_types')
  .select('id, code, label, color');

const { data: events } = await Astro.locals.supabase
  .from('events')
  .select('id, start_date, end_date, collaborator_id, event_type_id, collaborators(full_name), event_types(label, color)')
  .lte('start_date', rangeEnd)
  .gte('end_date', rangeStart)
  .eq('status', 'aprobado');

// Coberturas de backup: solo visuales, no son eventos registrados.
const { data: coverages } = await Astro.locals.supabase
  .from('shift_coverages')
  .select('start_date, end_date, backup:backup_collaborator_id(full_name), covered_shift:covered_shift_id(name)')
  .lte('start_date', rangeEnd)
  .gte('end_date', rangeStart);

function eventsForDay(iso: string) {
  return (events ?? []).filter((e: any) => iso >= e.start_date && iso <= e.end_date);
}

function coveragesForDay(iso: string) {
  return (coverages ?? []).filter((cv: any) => iso >= cv.start_date && iso <= cv.end_date);
}

const prev = addMonths(year, month, -1);
const next = addMonths(year, month, 1);
const todayISO = toISODate(today);
---
<Layout title="Calendario de colaboradores">
  <div class="shell">
    <div class="topbar">
      <span class="brand">Calendario de colaboradores</span>
      <nav>
        <a href="/admin">Panel admin</a>
      </nav>
    </div>

    <div class="month-nav">
      <a class="btn secondary" href={`/?y=${prev.year}&m=${prev.month}`}>&larr; anterior</a>
      <span class="month-label">{monthLabel(year, month)}</span>
      <a class="btn secondary" href={`/?y=${next.year}&m=${next.month}`}>siguiente &rarr;</a>
    </div>

    <div class="calendar-grid">
      {dayOfWeekLabels.map((d) => <div class="dow">{d}</div>)}
      {grid.map((date, i) => {
        const iso = toISODate(date);
        const isOutside = date.getMonth() + 1 !== month;
        const isToday = iso === todayISO;
        const dayEvents = eventsForDay(iso);
        const dayCoverages = coveragesForDay(iso);
        const dow = dayOfWeekLabels[i % 7];
        return (
          <div class={`day-cell ${isOutside ? 'outside' : ''} ${isToday ? 'today' : ''}`}>
            <div class="date-badge">
              <span class="num">{date.getDate()}</span>
              <span class="dow-label">{dow}</span>
            </div>
            <div class="events">
              {dayEvents.length === 0 && dayCoverages.length === 0 && <span class="no-events">Sin eventos</span>}
              {dayEvents.slice(0, 4).map((e: any) => (
                <div
                  class="event-chip"
                  style={`background:${e.event_types?.color ?? '#999'}`}
                  title={`${e.event_types?.label ?? ''} — ${e.collaborators?.full_name ?? 'General'}`}
                >
                  {e.collaborators?.full_name ?? e.event_types?.label}
                </div>
              ))}
              {dayEvents.length > 4 && <div class="event-chip" style="background:#8a8577">+{dayEvents.length - 4} más</div>}
              {dayCoverages.map((cv: any) => (
                <div
                  class="event-chip backup-chip"
                  title={`Backup: ${cv.backup?.full_name} cubre ${cv.covered_shift?.name}`}
                >
                  Backup · {cv.backup?.full_name}
                </div>
              ))}
            </div>
          </div>
        );
      })}
    </div>

    <div class="legend">
      {(eventTypes ?? []).map((t) => (
        <span class="tag"><span class="dot" style={`background:${t.color}`}></span>{t.label}</span>
      ))}
      <span class="tag"><span class="dot backup-dot"></span>Backup cubriendo (no es un evento registrado)</span>
    </div>
  </div>
</Layout>
