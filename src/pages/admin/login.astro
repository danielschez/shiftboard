---
import Layout from '../../layouts/Layout.astro';

const error = Astro.url.searchParams.get('error');
---
<Layout title="Ingresar · Admin">
  <div class="shell" style="max-width:400px;padding-top:80px">
    <h1 style="text-align:center">Administrador</h1>
    <p style="color:var(--ink-muted);margin-top:-8px; text-align:center">Calendario de Monitor :)</p>

    {error && <div class="alert error">{error}</div>}

    <form method="POST" action="/api/auth/login" class="card" style="margin-top:20px">
      <div class="field">
        <label for="email">Correo</label>
        <input type="email" id="email" name="email" required autofocus />
      </div>
      <div class="field">
        <label for="password">Contraseña</label>
        <input type="password" id="password" name="password" required />
      </div>
      <button type="submit" class="btn" style="width:100%;justify-content:center">Entrar</button>
    </form>
  </div>
</Layout>
