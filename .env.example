# Copia este archivo a .env y llena con los datos de tu proyecto de Supabase
# (Project Settings -> API en el dashboard de Supabase)

PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Service Settings -> API -> "service_role" key.
# NUNCA lleva el prefijo PUBLIC_: así Astro/Vite nunca la manda al navegador.
# Solo se usa server-side para crear/editar/eliminar usuarios desde /admin/usuarios.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
